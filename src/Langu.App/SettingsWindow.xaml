<Window x:Class="Langu.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Langu"
        Width="560"
        Height="720"
        MinWidth="500"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/langu.ico"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="Assets/langu.png" Width="40" Height="40" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Langu"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                 Fill="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource FieldLabel}" Margin="0" Text="In pausa"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Avvia" Click="OnStart"/>
                    <Button x:Name="PauseButton" Content="Pausa" Click="OnPause" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="2,10,2,0">
            <StackPanel>
                <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="1" Margin="0,0,0,8" Visibility="Collapsed"/>
                <TextBlock x:Name="DownloadText" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                <TextBlock x:Name="WarningText" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Nascondi" Click="OnHide" Margin="0"/>
                    <Button Style="{StaticResource QuietButton}" Content="Scarica modelli" Click="OnDownload"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Come si usa"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="1. Avvia  ·  2. Tieni premuto il tasto  ·  3. Sinistro una box, destro tutte, rotella un'area da rileggere. Doppio tap sul tasto: cancella tutto e interrompe OCR/traduzioni."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Tasto"/>
                                <ComboBox x:Name="ProbeKeyBox" SelectionChanged="OnSettingsChanged"/>
                                <Button x:Name="CaptureKeyButton" Style="{StaticResource QuietButton}"
                                        Content="Premi un tasto…" Click="OnCaptureKey" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Traduci in"/>
                                <ComboBox x:Name="TargetLanguageBox" SelectionChanged="OnSettingsChanged">
                                    <ComboBoxItem Content="Italiano"/>
                                    <ComboBoxItem Content="English"/>
                                </ComboBox>
                                <Button Style="{StaticResource QuietButton}" Content="Pulisci traduzioni"
                                        Click="OnClearPins" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Cosa leggere"/>
                        <WrapPanel Margin="0,0,0,10">
                            <RadioButton x:Name="ModeMonitor" Content="Monitor" Checked="OnCaptureModeChanged"/>
                            <RadioButton x:Name="ModeWindow" Content="Finestra" Checked="OnCaptureModeChanged"/>
                            <RadioButton x:Name="ModeRegion" Content="Regione" Checked="OnCaptureModeChanged"/>
                        </WrapPanel>
                        <StackPanel x:Name="MonitorPanel">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Monitor"/>
                            <ComboBox x:Name="MonitorBox" SelectionChanged="OnSettingsChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="WindowPanel">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Finestra"/>
                            <ComboBox x:Name="WindowBox" DisplayMemberPath="Title" SelectionChanged="OnSettingsChanged"/>
                            <WrapPanel Margin="0,2,0,0">
                                <Button Style="{StaticResource QuietButton}" Content="Aggiorna" Click="OnRefreshWindows"/>
                                <Button Style="{StaticResource QuietButton}" Content="Scegli cliccando" Click="OnPickWindow"/>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel x:Name="RegionPanel">
                            <TextBlock x:Name="RegionSummary" Style="{StaticResource FieldLabel}" Text="Nessuna regione"/>
                            <Button Style="{StaticResource QuietButton}" Content="Seleziona regione" Click="OnPickRegion" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Riconoscimento"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Lingua a schermo"/>
                        <ComboBox x:Name="SourceLanguageBox" SelectionChanged="OnSettingsChanged"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Motore"/>
                        <ComboBox x:Name="OcrBox" SelectionChanged="OnOcrChanged">
                            <ComboBoxItem Content="Auto — Windows, Rapid solo se serve"/>
                            <ComboBoxItem Content="Windows — latino, veloce e preciso"/>
                            <ComboBoxItem Content="RapidOCR — asiatico, più lento"/>
                        </ComboBox>
                        <TextBlock x:Name="OcrHintText" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"
                                   Text="Windows legge il testo normale. Rapid cerca in parallelo giapponese, cinese e coreano nel video."/>
                        <TextBlock x:Name="FpsLabel" Style="{StaticResource FieldLabel}" Text="Reattività col tasto premuto"/>
                        <Slider x:Name="FpsSlider" Minimum="1" Maximum="6" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnFpsChanged"/>
                        <CheckBox x:Name="OverlayCheck" Content="Mostra box e traduzioni" IsChecked="True" Click="OnSettingsChanged"/>
                        <TextBlock x:Name="ModelsStatusText" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"
                                   Text="Stato modelli: in attesa."/>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,0"
                                   Text="Ctrl+Shift+P avvia/pausa  ·  W finestra  ·  R regione  ·  L IT/EN"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
