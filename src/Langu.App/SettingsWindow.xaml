<Window x:Class="Langu.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Langu"
        Width="560"
        Height="720"
        MinWidth="500"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/langu.ico"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="Assets/langu.png" Width="40" Height="40" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Langu"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                 Fill="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource FieldLabel}" Margin="0" Text="Paused"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Start" Click="OnStart"/>
                    <Button x:Name="PauseButton" Content="Pause" Click="OnPause" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="2,10,2,0">
            <StackPanel>
                <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="1" Margin="0,0,0,8" Visibility="Collapsed"/>
                <TextBlock x:Name="DownloadText" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                <TextBlock x:Name="WarningText" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Hide" Click="OnHide" Margin="0"/>
                    <Button Style="{StaticResource QuietButton}" Content="Download models" Click="OnDownload"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="How to use"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="1. Start  ·  2. Hold the key  ·  3. Left-click one line, right-click all, middle-drag an area to rescan. Double-tap the key: clear everything and cancel OCR/translations."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Key"/>
                                <ComboBox x:Name="ProbeKeyBox" SelectionChanged="OnSettingsChanged"/>
                                <Button x:Name="CaptureKeyButton" Style="{StaticResource QuietButton}"
                                        Content="Press a key…" Click="OnCaptureKey" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Translate into"/>
                                <ComboBox x:Name="TargetLanguageBox" SelectionChanged="OnSettingsChanged">
                                    <ComboBoxItem Content="Italian"/>
                                    <ComboBoxItem Content="English"/>
                                </ComboBox>
                                <Button Style="{StaticResource QuietButton}" Content="Clear translations"
                                        Click="OnClearPins" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="What to read"/>
                        <WrapPanel Margin="0,0,0,10">
                            <RadioButton x:Name="ModeMonitor" Content="Monitor" Checked="OnCaptureModeChanged"/>
                            <RadioButton x:Name="ModeWindow" Content="Window" Checked="OnCaptureModeChanged"/>
                            <RadioButton x:Name="ModeRegion" Content="Region" Checked="OnCaptureModeChanged"/>
                        </WrapPanel>
                        <StackPanel x:Name="MonitorPanel">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Monitor"/>
                            <ComboBox x:Name="MonitorBox" SelectionChanged="OnSettingsChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="WindowPanel">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Window"/>
                            <ComboBox x:Name="WindowBox" DisplayMemberPath="Title" SelectionChanged="OnSettingsChanged"/>
                            <WrapPanel Margin="0,2,0,0">
                                <Button Style="{StaticResource QuietButton}" Content="Refresh" Click="OnRefreshWindows"/>
                                <Button Style="{StaticResource QuietButton}" Content="Click to pick" Click="OnPickWindow"/>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel x:Name="RegionPanel">
                            <TextBlock x:Name="RegionSummary" Style="{StaticResource FieldLabel}" Text="No region"/>
                            <Button Style="{StaticResource QuietButton}" Content="Select region" Click="OnPickRegion" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Recognition"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="On-screen language"/>
                        <ComboBox x:Name="SourceLanguageBox" SelectionChanged="OnSettingsChanged"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Engine"/>
                        <ComboBox x:Name="OcrBox" SelectionChanged="OnOcrChanged">
                            <ComboBoxItem Content="Auto — Windows layout, Rapid finds Japanese/CJK"/>
                            <ComboBoxItem Content="Windows — Latin, fast and accurate"/>
                            <ComboBoxItem Content="RapidOCR — Asian scripts, slower"/>
                        </ComboBox>
                        <TextBlock x:Name="OcrHintText" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"
                                   Text="Windows reads Latin. Rapid also looks for Japanese, Chinese, and Korean."/>
                        <TextBlock x:Name="FpsLabel" Style="{StaticResource FieldLabel}" Text="Hold-key responsiveness"/>
                        <Slider x:Name="FpsSlider" Minimum="1" Maximum="6" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnFpsChanged"/>
                        <CheckBox x:Name="OverlayCheck" Content="Show boxes and translations" IsChecked="True" Click="OnSettingsChanged"/>
                        <TextBlock x:Name="ModelsStatusText" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"
                                   Text="Models: waiting."/>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,0"
                                   Text="Ctrl+Shift+P start/pause  ·  W window  ·  R region  ·  L IT/EN"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
